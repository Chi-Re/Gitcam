# 后端环境变量示例（复制为 .env 或 export 到环境）

# 密钥（生产环境务必修改）
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_EXPIRE_HOURS=24

# MySQL
DATABASE_URL=mysql+pymysql://gitcam:gitcam_dev@127.0.0.1:3306/gitcam?charset=utf8mb4

# Git 仓库存储
REPO_ROOT=./data/repos

# MinIO 对象存储
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=gitcam_minio
MINIO_SECRET_KEY=gitcam_minio_dev
MINIO_BUCKET=gitcam-files
MINIO_SECURE=false

# 站点外部访问地址（git clone 地址展示用）
EXTERNAL_BASE_URL=http://127.0.0.1:5000

# 邮件通知（可配置开关；未配置时自动降级为仅站内通知）
MAIL_ENABLED=false
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_USE_SSL=true
MAIL_FROM=gitcam@localhost
